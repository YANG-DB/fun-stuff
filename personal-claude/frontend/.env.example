# Copy to .env.local and fill in. All optional — the app runs standalone without them.

# Force the chat client to call the real backend gateway (/api/chat) instead of the mock.
# VITE_USE_BACKEND=1

# "Sign in with Google" (identity only). Create an OAuth 2.0 Client ID of type
# "Web application" in Google Cloud Console, and add http://localhost:3000 as an
# Authorized JavaScript origin. No client secret is needed (client-side flow).
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
